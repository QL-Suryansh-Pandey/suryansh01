# Copy to .env and fill in real values. Never commit .env.

# Application under test (no default app server is started by the config).
BASE_URL=https://dev-nexonai.qkkalabs.com

# Login test account. Falls back to login/test-data/users.json (gitignored) if unset.
TEST_USERNAME=
TEST_PASSWORD=

# Optional overrides for the signup test. It generates unique values by
# default, so these are only needed to pin a specific account.
# TEST_FULL_NAME=
# TEST_EMAIL=
# TEST_COMPANY_NAME=
# TEST_DESIGNATION=

# Email report (npm run report:email). Either Gmail via a service shorthand...
EMAIL_SERVICE=gmail
SMTP_USER=
SMTP_PASSWORD=
# ...or a raw SMTP server instead of EMAIL_SERVICE:
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=false

REPORT_TO=
REPORT_FROM=
REPORT_SUBJECT=
